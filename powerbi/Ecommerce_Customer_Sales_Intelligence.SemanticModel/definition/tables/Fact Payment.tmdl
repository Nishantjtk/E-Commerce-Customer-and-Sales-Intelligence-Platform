table 'Fact Payment'
	lineageTag: 0cbcbc85-76dc-4641-a5c2-48c6ed87eb54

	measure 'Delivered Payment Value' = CALCULATE(SUM('Fact Payment'[payment_value]), 'Fact Payment'[order_status] = "delivered")
		lineageTag: c0d6e248-9ded-4fd6-afb0-64c604664c51

	measure 'Payment Records' = COUNTROWS('Fact Payment')
		lineageTag: c6b0033c-9366-4dea-ae7e-44507af0068c

	measure 'Average Payment Installments' = AVERAGE('Fact Payment'[payment_installments])
		lineageTag: 4e9299d0-72c9-43b2-bdb1-3bedb8bfe715

	measure 'Payment Value Share' =
			DIVIDE(
			    [Delivered Payment Value],
			    CALCULATE([Delivered Payment Value], REMOVEFILTERS('Fact Payment'[payment_type]))
			)
		lineageTag: 0a4400c5-4f36-49b6-964d-845515c586b0

