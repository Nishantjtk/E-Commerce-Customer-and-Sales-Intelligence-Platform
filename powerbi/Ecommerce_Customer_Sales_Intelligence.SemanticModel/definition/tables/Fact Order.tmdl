table 'Fact Order'
	lineageTag: e4907e84-0831-4fe1-8eec-def1f49b4b17

	measure 'All Orders' = COUNTROWS('Fact Order')
		lineageTag: ca08b24e-cd15-44a9-bec7-559260c06e83

	measure 'Delivered Orders' = CALCULATE([All Orders], 'Fact Order'[order_status] = "delivered")
		lineageTag: fd535a27-5b0b-4500-bc26-021063903c78

	measure 'Delivered Revenue' = CALCULATE(SUM('Fact Order'[item_revenue]), 'Fact Order'[order_status] = "delivered")
		lineageTag: 4ea6b3d4-5a58-437d-9e6e-71dacb931f5b

	measure 'Delivered Freight Revenue' = CALCULATE(SUM('Fact Order'[freight_revenue]), 'Fact Order'[order_status] = "delivered")
		lineageTag: f1c13555-56ba-40ae-b67f-1f9402e7d460

	measure 'Delivered GMV' = CALCULATE(SUM('Fact Order'[gross_merchandise_value]), 'Fact Order'[order_status] = "delivered")
		lineageTag: 9d9fb263-1cc7-4350-9e3a-b28819f95bf3

	measure 'Delivered Customers' =
			CALCULATE(
			    DISTINCTCOUNT('Fact Order'[customer_unique_id]),
			    'Fact Order'[order_status] = "delivered"
			)
		lineageTag: f68984c0-43fd-416a-956e-c5c9bd1abe13

	measure 'Average Order Value' = DIVIDE([Delivered Revenue], [Delivered Orders])
		lineageTag: dfa63be7-2f51-46db-97a7-f75a37e6ab7c

	measure 'Average Revenue per Customer' = DIVIDE([Delivered Revenue], [Delivered Customers])
		lineageTag: bb8973e8-005a-4e3a-ae40-ef2d95a111d8

	measure 'Average Delivery Days' =
			CALCULATE(
			    AVERAGE('Fact Order'[delivery_days]),
			    'Fact Order'[order_status] = "delivered",
			    NOT ISBLANK('Fact Order'[delivery_days])
			)
		lineageTag: b706305d-2df1-4ce2-8951-09873664d270

	measure 'Late Deliveries' =
			CALCULATE(
			    COUNTROWS('Fact Order'),
			    'Fact Order'[order_status] = "delivered",
			    NOT ISBLANK('Fact Order'[delivery_days]),
			    'Fact Order'[is_late_delivery] = 1
			)
		lineageTag: d5a93a8f-c778-4cee-abea-b5fa6a5aea35

	measure 'Delivered With Actual Date' =
			CALCULATE(
			    COUNTROWS('Fact Order'),
			    'Fact Order'[order_status] = "delivered",
			    NOT ISBLANK('Fact Order'[delivery_days])
			)
		lineageTag: 82ea03ad-7913-419c-974d-b1320ac893a5

	measure 'Late Delivery Rate' = DIVIDE([Late Deliveries], [Delivered With Actual Date])
		lineageTag: c9e29b87-3de4-4dd6-a1e8-9c02c376af3f

	measure 'Revenue MoM %' =
			VAR PreviousMonthRevenue = CALCULATE([Delivered Revenue], DATEADD('Dim Date'[Date], -1, MONTH))
			RETURN DIVIDE([Delivered Revenue] - PreviousMonthRevenue, PreviousMonthRevenue)
		lineageTag: 3fd16b7b-8999-4f1c-a893-12613afe133c

	measure 'Order MoM %' =
			VAR PreviousMonthOrders = CALCULATE([Delivered Orders], DATEADD('Dim Date'[Date], -1, MONTH))
			RETURN DIVIDE([Delivered Orders] - PreviousMonthOrders, PreviousMonthOrders)
		lineageTag: 2ddd4d0d-f680-4605-9a30-03164157db56

