	column 'Purchase Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: 97510902-1375-4792-a957-b51c9ae6d084
		summarizeBy: none
		sourceColumn: Purchase Date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column 'Delivery Status' =
			SWITCH(
			    TRUE(),
			    ISBLANK('Fact Order'[delivery_days]), "Not delivered",
			    'Fact Order'[is_late_delivery] = 1, "Late",
			    "On time / early"
			)
		dataType: string
		lineageTag: c0861649-cfdb-44ea-adfa-917d1eb3d7ea

	partition 'Fact Order' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5433", "ecommerce_intelligence"),
				    View = Source{[Schema="analytics", Item="order_financials"]}[Data],
				    #"Added Purchase Date" = Table.AddColumn(View, "Purchase Date", each Date.From([order_purchase_timestamp]), type date)
				in
				    #"Added Purchase Date"

