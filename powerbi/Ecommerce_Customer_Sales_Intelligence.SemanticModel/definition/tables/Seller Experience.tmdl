table 'Seller Experience'
	lineageTag: 617a3b3f-fcf1-4a13-b042-b7c16024ec23

	measure 'Seller Revenue' = SUM('Seller Experience'[item_revenue])
		lineageTag: 9fa4016e-4b2c-4d2e-abac-c961d695f7e1

	measure 'Seller Delivered Orders' = SUM('Seller Experience'[delivered_orders])
		lineageTag: 721be34f-8a83-457d-b059-1c025024ebfa

	measure 'Seller Average Review Score' = AVERAGE('Seller Experience'[avg_review_score])
		lineageTag: 70817a15-005a-4f40-9995-5110438d45d4

	measure 'Seller Late Delivery Rate' = AVERAGE('Seller Experience'[late_delivery_rate])
		lineageTag: ff5bf82a-adc3-47d6-88f5-3e618c4b82a0

	column seller_id
