table 'Fact Order Line'
	lineageTag: 415cbb01-9093-48a2-9f93-2b1515af3062

	measure 'Delivered Item Revenue (Line)' = CALCULATE(SUM('Fact Order Line'[price]), 'Fact Order Line'[order_status] = "delivered")
		lineageTag: 27e40477-55ca-4b50-b5f0-063cf2c32711

	measure 'Delivered Freight (Line)' = CALCULATE(SUM('Fact Order Line'[freight_value]), 'Fact Order Line'[order_status] = "delivered")
		lineageTag: 370be72c-4332-49a3-82df-f7cad598eaf6

	measure 'Delivered Line GMV' = [Delivered Item Revenue (Line)] + [Delivered Freight (Line)]
		lineageTag: c58d54f5-6266-4372-b24b-3e51176c6761

	measure 'Delivered Orders (Line)' = CALCULATE(DISTINCTCOUNT('Fact Order Line'[order_id]), 'Fact Order Line'[order_status] = "delivered")
		lineageTag: 13a8c1a1-eed0-42cc-b1a1-a9554618a334

	measure 'Product Rank by Revenue' = RANKX(ALL('Fact Order Line'[product_id]), [Delivered Item Revenue (Line)], , DESC, DENSE)
		lineageTag: f4599cf2-50ca-4a9b-9892-4be83a966b96

