table 'Fact Review'
	lineageTag: c89d95f2-7baa-422b-bb77-b10c71419f78

	measure 'Review Count' = COUNTROWS('Fact Review')
		lineageTag: b687b369-47cd-4ead-883f-f7ce2da952e1

	measure 'Average Review Score' = AVERAGE('Fact Review'[review_score])
		lineageTag: f415ac08-e946-4947-af4b-cf1febe10eab

	measure 'Low Review Count' = CALCULATE([Review Count], 'Fact Review'[review_score] <= 2)
		lineageTag: 3ab9f70b-f654-4499-abc6-b5c7bb771537

	measure 'Low Review Rate' = DIVIDE([Low Review Count], [Review Count])
		lineageTag: e7e6e03f-ccf2-42b4-b914-35fbb9dcf1e3

	column review_row_id
		dataType: int64
		lineageTag: ba30f446-f370-4f68-9ab3-d879e2eb6ad8
		sourceColumn: review_row_id

	column review_id
		dataType: string
		lineageTag: e58caeb6-eea3-482c-9484-c95099dc1fe1
		sourceColumn: review_id

	column order_id
		dataType: string
		lineageTag: 9c4bb8f7-8358-490f-ac2f-8626a24f1048
		sourceColumn: order_id

	column review_score
		dataType: int64
		lineageTag: ee7ebf67-d279-4277-be41-96e5036c2b2b
		sourceColumn: review_score

	column review_creation_date
		dataType: dateTime
		lineageTag: 02340076-85d5-400d-9c2e-162f0e1b60c4
