table 'Category Experience'
	lineageTag: e4fdcfee-db23-46a1-8fbb-e9e645f49b5a

	measure 'Category Revenue' = SUM('Category Experience'[revenue])
		lineageTag: 545a3cec-d3b0-4964-95a3-b5e5d982e8e1

	measure 'Category Freight Revenue' = SUM('Category Experience'[freight_revenue])
		lineageTag: 780467d1-df27-44de-84a2-94d785596446

	measure 'Category Delivered Orders' = SUM('Category Experience'[delivered_orders])
		lineageTag: 92cef0f3-087b-41ec-be3c-f53cb3401005

	measure 'Category Average Review Score' = AVERAGE('Category Experience'[avg_review_score])
		lineageTag: e4b714f3-f410-434e-9e85-87074ba67bae

	measure 'Category Late Delivery Rate' = AVERAGE('Category Experience'[late_delivery_rate])
		lineageTag: 56e95b84-a674-4e8f-bcd2-407021aac286

	column category_name
