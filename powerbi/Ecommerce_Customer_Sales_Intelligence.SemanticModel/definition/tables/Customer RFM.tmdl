table 'Customer RFM'
	lineageTag: d1c834e8-041b-4faf-b7ec-755ccd6db26a

	measure 'RFM Customers' = DISTINCTCOUNT('Customer RFM'[customer_unique_id])
		lineageTag: 8b9c90be-549f-4d0e-971f-c8b22a6604ca

	measure 'RFM Revenue' = SUM('Customer RFM'[monetary])
		lineageTag: 4e235a25-f5c5-4426-8621-917988954cb4

	measure 'Repeat Customers' = CALCULATE([RFM Customers], 'Customer RFM'[frequency] > 1)
		lineageTag: 9f29dd16-09b8-49a0-bbce-b6504cec1ce4

	measure 'Repeat Customer Rate' = DIVIDE([Repeat Customers], [RFM Customers])
		lineageTag: 0b9e86fc-136a-4f9e-8423-183e63a6fdc3

	column customer_unique_id
